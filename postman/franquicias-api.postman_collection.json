          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('una entrada por sucursal con productos', () => pm.expect(pm.response.json()).to.have.lengthOf(2));",
                  "console.log(pm.response.json());"
                ]
