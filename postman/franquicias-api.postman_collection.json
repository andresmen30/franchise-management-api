            },
            "description": "Criterio 3. Guarda el id en {{branchId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Centro\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('branchId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
