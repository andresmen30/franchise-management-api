        {
          "name": "Modificar stock del Cafe",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/franchises/{{franchiseId}}/branches/{{branchId}}/products/{{productId}}/stock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "franchises",
                "{{franchiseId}}",
                "branches",
                "{{branchId}}",
                "products",
                "{{productId}}",
                "stock"
              ]
            },
            "description": "Criterio 6. PUT porque fijar el stock a un valor absoluto es idempotente: reintentar no acumula.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": 500\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('stock actualizado', () => pm.expect(pm.response.json().stock).to.eql(500));"
                ]
              }
            }
          ]
        },
        {
          "name": "Mayor stock (Cafe ya desplazo al Te)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/franchises/{{franchiseId}}/branches/top-stock-products",
