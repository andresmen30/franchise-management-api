{
  "info": {
    "name": "Franquicias API",
    "description": "API de franquicias, sucursales y productos.\n\nEjecutar las carpetas en orden: las peticiones guardan los identificadores generados en variables de coleccion, de modo que las siguientes ya los tienen.\n\nVariable `baseUrl`: http://localhost:8080/api/v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "franchiseId",
      "value": ""
    },
    {
      "key": "branchId",
      "value": ""
    },
    {
      "key": "branchNorteId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 - Flujo principal",
      "item": [
        {
          "name": "Crear franquicia",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/franchises",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "franchises"
              ]
            },
            "description": "Criterio 2. Guarda el id en {{franchiseId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nequi Store\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('devuelve Location', () => pm.expect(pm.response.headers.has('Location')).to.be.true);",
                  "pm.collectionVariables.set('franchiseId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
